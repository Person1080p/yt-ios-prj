<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Granted per developer account via https://developer.apple.com/contact/carplay/
	     Builds will fail to sign with this key present until Apple approves it.
	     Comment it out to build/run without CarPlay templates. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
